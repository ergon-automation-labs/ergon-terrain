# Environment variables for local development and testing
# Copy this file to .env and customize for your local environment
# Never commit .env - it's gitignored

# Database Configuration (required for tests; Terrain uses terrain schema + pgvector)
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_USER=postgres
DATABASE_PASSWORD=postgres
DATABASE_NAME=ergon_terrain_dev

# NATS Configuration (optional, used at runtime)
NATS_HOST=localhost
NATS_PORT=4222

# Optional: map /app/lessons paths from TUI to a bot-readable host path
TERRAIN_LESSONS_ROOT=/Users/abby/Documents/terrain_gameshow

# Elixir Environment
MIX_ENV=dev
